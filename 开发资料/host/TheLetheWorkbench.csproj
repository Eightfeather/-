<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TheLetheWorkbench</AssemblyName>
    <RootNamespace>TheLetheWorkbench</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>NU1701;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>..\build\payload\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>..\build\payload\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\build\payload\payload.server.exe.gz" LogicalName="payload.server.exe.gz" />
    <EmbeddedResource Include="..\build\payload\Microsoft.Web.WebView2.Core.dll" LogicalName="payload.Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="..\build\payload\Microsoft.Web.WebView2.WinForms.dll" LogicalName="payload.Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="..\build\payload\WebView2Loader.dll" LogicalName="payload.WebView2Loader.dll" />
  </ItemGroup>
</Project>